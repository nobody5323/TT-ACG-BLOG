<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nobody.domain.mapper.ContentPostTagMapper">

    <select id="selectTagNamesByPostIds" resultType="java.util.HashMap">
        SELECT
            pt.post_id       AS postId,
            t.tag_name       AS tagName
        FROM content_post_tag pt
                 JOIN content_tag t ON t.id = pt.tag_id
        WHERE pt.post_id IN
        <foreach collection="postIds" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
          AND t.status = 1
        ORDER BY pt.post_id ASC, t.id ASC
    </select>

</mapper>
