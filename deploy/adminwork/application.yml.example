spring:
  datasource:
    url: jdbc:mysql://mysql:3306/${MYSQL_DATABASE:acgblog}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${MYSQL_USER:acgblog}
    password: ${MYSQL_PASSWORD:change-me}
    driver-class-name: com.mysql.cj.jdbc.Driver

  servlet:
    multipart:
      max-file-size: 2MB
      max-request-size: 5MB

  data:
    redis:
      host: redis
      port: 6379
      password: ${REDIS_PASSWORD:change-me-redis}
      database: 1
      connect-timeout: 2000ms

  mvc:
    pathmatch:
      matching-strategy: ant_path_matcher

server:
  port: 7980

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml

  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

  global-config:
    db-config:
      logic-delete-field: delFlag
      logic-delete-value: 1
      logic-not-delete-value: 0
      id-type: auto

springdoc:
  api-docs:
    enabled: false
  swagger-ui:
    enabled: false

